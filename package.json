{
  "name": "dsh-agent-menu",
  "version": "0.8.3",
  "description": "A restrained context menu for DeepSeek Harness: copy selections and code, manage links/files/images, and add real workspace/session directory actions to native sidebar menus.",
  "description_i18n": {
    "zh-CN": "DeepSeek Harness 精简右键菜单：复制选区与代码，处理链接、文件和图片，并在原生工作区/会话菜单中补充真实目录操作。不包含 AI 提问或提示词发送。"
  },
  "license": "MIT",
  "author": "xsllo425",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "lib/client.js",
    "lib/index.js",
    "!lib/*.bak*",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "scripts/*.mjs",
    "tests/*.test.mjs",
    "docs/DEVELOPMENT.md",
    "docs/RELEASE.md",
    "docs/RELEASE-v0.7.1.md",
    "docs/RELEASE-v0.8.0.md",
    "docs/RELEASE-v0.8.1.md",
    "docs/RELEASE-v0.8.2.md",
    "docs/RELEASE-v0.8.3.md",
    "CHANGELOG.md",
    "NOTICE",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "context-menu",
    "right-click",
    "clipboard",
    "code-block",
    "markdown",
    "image",
    "sidebar",
    "workspace",
    "session"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "scripts": {
    "check": "node scripts/check-manifest.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "node --check lib/client.js && node --check lib/index.js && node --test tests/*.test.mjs && node scripts/check-manifest.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xsllo425/dsh-agent-menu.git"
  },
  "homepage": "https://github.com/xsllo425/dsh-agent-menu#readme",
  "bugs": {
    "url": "https://github.com/xsllo425/dsh-agent-menu/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dsh": {
    "runtime": "host",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "dshLocal": {
    "title": "右键菜单（精简版）",
    "summary": "只在对话消息和输入框里接管右键：复制选中文字、链接、文件、图片、输入框编辑；侧栏原生菜单补目录操作。",
    "features": [
      "选中文字：复制",
      "链接：复制地址 / Markdown 链接 / 在浏览器打开",
      "文件：复制路径 / 打开文件位置 / 用默认程序打开",
      "代码块：复制代码",
      "图片：复制 / 另存为",
      "输入框：剪切 / 复制 / 粘贴 / 全选",
      "工作区/会话：原生操作 + 新建会话 / 复制目录 / 打开位置 / 删除会话"
    ],
    "files": [
      "lib/client.js",
      "lib/index.js",
      "tests/scope.test.mjs",
      "tests/sidebar-actions.test.mjs",
      "tests/smoke.test.mjs",
      "tests/rightclick-native.test.mjs",
      "tests/image-bytes.test.mjs"
    ],
    "background": "没有定时器和页面监听：只在右键、点击、按键、滚动和窗口变化时响应。",
    "backup": "E:\\Backups\\agent-menu-20261019",
    "toggle": "patch-row"
  }
}
